# =============================================================================
# Backend environment variables (server-side secrets)
# =============================================================================
# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and must NEVER be committed.
#
# These keys live ONLY on the FastAPI server. They must NOT be exposed to the
# React frontend (anything in the browser bundle is publicly visible).

# Google Gemini API key — used for AI coaching feedback.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key — full admin access. Server-only. NEVER ship to
# the frontend. Use the anon key (in the frontend .env) for browser access.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
