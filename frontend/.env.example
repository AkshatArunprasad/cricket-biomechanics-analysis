# =============================================================================
# Frontend environment variables (PUBLIC — bundled into the browser)
# =============================================================================
# Copy this file to ".env" and fill in your values.
#
# IMPORTANT: Vite exposes ANY variable prefixed with "VITE_" to the browser.
# Only put NON-SECRET, public values here. Never put service-role keys or the
# Gemini key here — route those through the FastAPI backend instead.

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase project URL (same as backend, safe to expose).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON (public) key — designed to be public, protected by Row Level
# Security policies. Safe for the browser.
VITE_SUPABASE_ANON_KEY=your_anon_key_here
